# NeonDB or any Postgres connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=change-me
PORT=5001
CLIENT_URL=http://localhost:3000

# Optional: seeded admin (defaults to admin@example.com / password123)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Optional: Razorpay test-mode keys for "Add money" (Dashboard -> Account &
# Settings -> API Keys, with Test Mode on). Live keys (rzp_live_) are refused.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
